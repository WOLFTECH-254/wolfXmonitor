# wolfXmonitor — environment variables
# Copy to .env and fill in real values. Never commit .env to git.

NODE_ENV=production
PORT=8080

# PostgreSQL connection string
DATABASE_URL=postgresql://wolfxuser:yourpassword@localhost:5432/wolfxmonitor

# Random 64-char string — generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_strong_secret

# Brevo transactional email (entered here or via Admin Panel in the app)
BREVO_API_KEY=xkeysib-...
